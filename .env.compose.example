# Absolute host path to the unlocked/decrypted movie directory.
# Windows example: D:/Movies
MOVIE_PATH=D:/Movies

# Use a long, unique password. Do not commit the populated .env.compose file.
MASTER_PASSWORD=replace-with-a-long-random-password
SESSION_HOURS=12

# Token for a remotely managed Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token

# Optional settings.
TMDB_API_KEY=
APP_PORT=8000
